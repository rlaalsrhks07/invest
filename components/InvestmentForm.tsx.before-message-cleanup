"use client";

import { useRouter } from "next/navigation";
import {
  type ChangeEvent,
  useMemo,
  useState,
} from "react";

import AssetPriceChart from "@/components/AssetPriceChart";
import type { StaticAsset } from "@/lib/gameData";
import {
  getMaxInvestmentPerAsset,
} from "@/lib/investmentRules";

type InvestmentFormProps = {
  teamId: string;
  roundId: string;
  assets: StaticAsset[];
  currentCash: number;
  alreadySubmitted: boolean;
  disabled: boolean;
  disabledReason?: string;
};

export default function InvestmentForm({
  teamId,
  roundId,
  assets,
  currentCash,
  alreadySubmitted,
  disabled,
  disabledReason,
}: InvestmentFormProps) {
  const router = useRouter();

  const [amounts, setAmounts] =
    useState<
      Record<string, string>
    >({});

  const [
    isSubmitted,
    setIsSubmitted,
  ] = useState(
    alreadySubmitted
  );

  const [loading, setLoading] =
    useState(false);

  const [
    submittedSummary,
    setSubmittedSummary,
  ] = useState<{
    totalAmount: number;
    remainingCash: number;
  } | null>(null);

  const totalAmount =
    useMemo(() => {
      return assets.reduce(
        (sum, asset) => {
          const rawValue =
            amounts[
              asset.id
            ] ?? "";

          if (
            rawValue.trim() ===
            ""
          ) {
            return sum;
          }

          const amount =
            Number(rawValue);

          if (
            !Number.isFinite(
              amount
            )
          ) {
            return sum;
          }

          return sum + amount;
        },
        0
      );
    }, [amounts, assets]);

  const hasInvalidAmount =
    useMemo(() => {
      return assets.some(
        (asset) => {
          const rawValue =
            amounts[
              asset.id
            ] ?? "";

          if (
            rawValue.trim() ===
            ""
          ) {
            return false;
          }

          const amount =
            Number(rawValue);

          return (
            !Number.isSafeInteger(
              amount
            ) ||
            amount < 0
          );
        }
      );
    }, [amounts, assets]);

  const investmentBaseCash =
    submittedSummary
      ? submittedSummary.totalAmount +
        submittedSummary.remainingCash
      : currentCash;

  const maxInvestmentPerAsset =
    getMaxInvestmentPerAsset(
      investmentBaseCash
    );

  const overLimitAssets =
    useMemo(() => {
      return assets.flatMap(
        (asset) => {
          const rawValue =
            amounts[
              asset.id
            ] ?? "";

          if (
            rawValue.trim() ===
            ""
          ) {
            return [];
          }

          const amount =
            Number(rawValue);

          if (
            !Number.isSafeInteger(
              amount
            ) ||
            amount <=
              maxInvestmentPerAsset
          ) {
            return [];
          }

          return [
            {
              assetId:
                asset.id,
              assetName:
                asset.name,
              amount,
              excessAmount:
                amount -
                maxInvestmentPerAsset,
            },
          ];
        }
      );
    }, [
      amounts,
      assets,
      maxInvestmentPerAsset,
    ]);

  const hasAssetLimitViolation =
    overLimitAssets.length > 0;

  const getAssetLimitViolation =
    (assetId: string) =>
      overLimitAssets.find(
        (item) =>
          item.assetId ===
          assetId
      );

  const remainingCash =
    currentCash - totalAmount;

  const displayedTotalAmount =
    submittedSummary?.totalAmount ??
    totalAmount;
  const displayedRemainingCash =
    submittedSummary?.remainingCash ??
    remainingCash;

  const formDisabled =
    disabled ||
    isSubmitted ||
    loading;

  const handleChange = (
    assetId: string,
    value: string
  ) => {
    if (formDisabled) {
      return;
    }

    setAmounts(
      (previous) => ({
        ...previous,
        [assetId]: value,
      })
    );
  };

  const handleSubmit =
    async () => {
      if (disabled) {
        alert(
          disabledReason ??
            "현재는 투자할 수 없습니다."
        );

        return;
      }

      if (isSubmitted) {
        alert(
          "이미 투자를 제출했습니다."
        );

        return;
      }

      if (
        hasInvalidAmount
      ) {
        alert(
          "투자 금액은 0원 이상의 정수로 입력해 주세요."
        );

        return;
      }

      if (
        hasAssetLimitViolation
      ) {
        const firstViolation =
          overLimitAssets[0];

        alert(
          `한 종목에는 현재 재산의 50%까지만 투자할 수 있습니다.\n\n${firstViolation.assetName}의 최대 투자 가능 금액은 ${maxInvestmentPerAsset.toLocaleString(
            "ko-KR"
          )}원입니다.`
        );

        return;
      }

      if (
        totalAmount >
        currentCash
      ) {
        alert(
          "총 투자 금액이 현재 보유 자금을 초과합니다."
        );

        return;
      }

      const investments =
        assets.map(
          (asset) => {
            const rawValue =
              amounts[
                asset.id
              ] ?? "";

            return {
              assetId:
                asset.id,
              amount:
                rawValue.trim() ===
                ""
                  ? 0
                  : Number(
                      rawValue
                    ),
            };
          }
        );

      const confirmationMessage =
        totalAmount === 0
          ? "이번 라운드에는 투자하지 않고 전액을 현금으로 보유합니다.\n\n제출 후에는 수정할 수 없습니다."
          : `총 ${totalAmount.toLocaleString(
              "ko-KR"
            )}원을 투자합니다.\n\n투자 후 현금은 ${remainingCash.toLocaleString(
              "ko-KR"
            )}원입니다. 제출 후에는 수정할 수 없습니다.`;

      const ok = confirm(
        confirmationMessage
      );

      if (!ok) {
        return;
      }

      try {
        setLoading(true);

        const response =
          await fetch(
            "/api/investments/submit",
            {
              method:
                "POST",
              headers: {
                "Content-Type":
                  "application/json",
              },
              body: JSON.stringify(
                {
                  teamId,
                  roundId,
                  investments,
                }
              ),
            }
          );

        const data =
          await response.json();

        if (!response.ok) {
          alert(
            data.error ??
              "투자 제출에 실패했습니다."
          );

          return;
        }

        const serverInvestedAmount =

          Number(data.investedAmount);

        const serverRemainingCash =

          Number(data.remainingCash);


        const submittedTotalAmount =

          Number.isSafeInteger(

            serverInvestedAmount

          )

            ? serverInvestedAmount

            : totalAmount;

        const submittedRemainingCash =

          Number.isSafeInteger(

            serverRemainingCash

          )

            ? serverRemainingCash

            : currentCash -

              submittedTotalAmount;


        setSubmittedSummary({

          totalAmount:

            submittedTotalAmount,

          remainingCash:

            submittedRemainingCash,

        });


        setIsSubmitted(
          true
        );

        alert(
          totalAmount === 0
            ? "0원 투자가 제출되었습니다."
            : `투자가 제출되었습니다.\n남은 현금은 ${Number(
                data.remainingCash
              ).toLocaleString(
                "ko-KR"
              )}원입니다.`
        );

        router.refresh();
      } catch (error) {
        console.error(
          error
        );

        alert(
          "투자 제출 중 오류가 발생했습니다."
        );
      } finally {
        setLoading(false);
      }
    };

  return (
    <section className="rounded-2xl border border-indigo-100 bg-white p-6 shadow-lg shadow-indigo-100/40">
      <header className="flex items-end justify-between gap-6">
        <div>
          <h2 className="text-2xl font-black text-slate-900">
            산업별 투자
          </h2>
        </div>

        <div className="rounded-xl border border-indigo-100 bg-indigo-50 px-5 py-3 text-right">
          <div className="text-xs text-indigo-400">
            투자 가능 현금
          </div>

          <div className="mt-1 text-xl font-black tabular-nums text-slate-900">
            {currentCash.toLocaleString(
              "ko-KR"
            )}
            원
          </div>
        </div>
      </header>

      {(disabled ||
        isSubmitted) && (
        <div className="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm font-medium text-amber-800">
          {isSubmitted
            ? "이미 투자를 제출했습니다. 제출한 투자는 수정할 수 없습니다."
            : disabledReason ??
              "현재는 투자할 수 없습니다."}
        </div>
      )}

      <div className="mt-6 grid grid-cols-2 gap-5">
        {assets.map(
          (asset, index) => (
            <article
              key={asset.id}
              className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-lg hover:shadow-indigo-100/60"
            >
              <div className="flex items-start gap-4">
                <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-100 text-sm font-black text-indigo-700">
                  {String(
                    index + 1
                  ).padStart(
                    2,
                    "0"
                  )}
                </div>

                <div>
                  <h3 className="text-xl font-black text-slate-900">
                    {asset.name}
                  </h3>

                  <p className="mt-1 min-h-12 text-sm leading-6 text-slate-500">
                    {
                      asset.description
                    }
                  </p>
                </div>
              </div>

              <AssetPriceChart
                assetId={
                  asset.id
                }
                currentRoundId={
                  roundId
                }
                revealCurrentRoundResult={
                  disabled
                }
              />

              <label
                htmlFor={`investment-${asset.id}`}
                className="mt-5 block text-sm font-black text-slate-700"
              >
                투자 금액
              </label>

              <div
                className={`mt-2 flex items-center overflow-hidden rounded-xl border bg-white focus-within:ring-2 ${
                  getAssetLimitViolation(
                    asset.id
                  )
                    ? "border-red-400 focus-within:border-red-500 focus-within:ring-red-500/10"
                    : "border-slate-300 focus-within:border-indigo-500 focus-within:ring-indigo-500/10"
                }`}
              >
<input
  id={`investment-${asset.id}`}
  type="text"
  inputMode="numeric"
  pattern="[0-9]*"
  value={amounts[asset.id] ?? ""}
  onChange={(event: ChangeEvent<HTMLInputElement>) => {
    const numericValue = event.target.value.replace(
      /[^0-9]/g,
      ""
    );

    handleChange(asset.id, numericValue);
  }}
  disabled={formDisabled}
  placeholder="0"
  className="w-full border-0 px-4 py-3 text-right text-lg font-black text-slate-900 outline-none disabled:bg-slate-100 disabled:text-slate-400"
/>

                <span className="border-l border-slate-200 bg-slate-50 px-4 py-3 font-bold text-slate-500">
                  원
                </span>
              </div>

              {getAssetLimitViolation(
                asset.id
              ) ? (
                <p className="mt-2 rounded-lg bg-red-50 px-3 py-2 text-sm font-bold text-red-700">
                  최대 투자 가능 금액은{" "}
                  {maxInvestmentPerAsset.toLocaleString(
                    "ko-KR"
                  )}
                  원입니다. 현재 입력값은 한도를{" "}
                  {getAssetLimitViolation(
                    asset.id
                  )?.excessAmount.toLocaleString(
                    "ko-KR"
                  )}
                  원 초과했습니다.
                </p>
              ) : (
                <p className="mt-2 text-right text-xs font-bold text-slate-400">
                  종목당 최대{" "}
                  {maxInvestmentPerAsset.toLocaleString(
                    "ko-KR"
                  )}
                  원 (현재 재산의 50%)
                </p>
              )}
            </article>
          )
        )}
      </div>

      <div className="sticky bottom-4 z-20 mt-6 rounded-2xl border border-indigo-200 bg-white/95 p-4 shadow-2xl shadow-indigo-200/50 backdrop-blur">
        {!isSubmitted &&
          hasAssetLimitViolation && (
            <div className="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-bold text-red-700">
              한 종목에는 현재 재산의 50%인 최대{" "}
              {maxInvestmentPerAsset.toLocaleString(
                "ko-KR"
              )}
              원까지만 투자할 수 있습니다. 빨간색으로 표시된 투자 금액을 줄여 주세요.
            </div>
          )}

        <div className="flex items-center justify-between gap-6">
          <div className="flex gap-8">
            <div>
              <div className="text-xs font-bold text-slate-400">
                총 투자 금액
              </div>

              <div
                className={`mt-1 text-xl font-black tabular-nums ${
                  !isSubmitted &&
                  (totalAmount >
                    currentCash ||
                    hasInvalidAmount ||
                    hasAssetLimitViolation)
                    ? "text-red-600"
                    : "text-slate-900"
                }`}
              >
                {displayedTotalAmount.toLocaleString(
                  "ko-KR"
                )}
                원
              </div>
            </div>

            <div>
              <div className="text-xs font-bold text-slate-400">
                투자 후 현금
              </div>

              <div
                className={`mt-1 text-xl font-black tabular-nums ${
                  !isSubmitted &&
                  remainingCash <
                    0
                    ? "text-red-600"
                    : "text-slate-900"
                }`}
              >
                {displayedRemainingCash.toLocaleString(
                  "ko-KR"
                )}
                원
              </div>
            </div>
          </div>

          <button
            type="button"
            onClick={
              handleSubmit
            }
            disabled={
              formDisabled ||
              hasInvalidAmount ||
              hasAssetLimitViolation ||
              totalAmount >
                currentCash
            }
            className="min-w-48 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 px-7 py-4 text-base font-black text-white shadow-lg shadow-indigo-200 transition hover:from-indigo-700 hover:to-blue-700 disabled:cursor-not-allowed disabled:opacity-40"
          >
            {loading
              ? "제출 중..."
              : isSubmitted
                ? "제출 완료"
                : totalAmount ===
                    0
                  ? "0원 투자 제출"
                  : "투자 제출"}
          </button>
        </div>
      </div>
    </section>
  );
}